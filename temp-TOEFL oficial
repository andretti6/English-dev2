<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Department Store Role-Play</title>
    <script src="https://cdn.tailwindcss.com">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js">
    </script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js">
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            font-family: 'Inter', sans-serif;
            overflow: hidden;
            height: 100%;
            background: #0f172a;
        }
        .glass-panel {
            background: rgba(15, 23, 42, 0.78);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-light {
            background: rgba(30, 41, 59, 0.65);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.06);
        }
        canvas {
            display: block;
            outline: none;
        }
        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }

        @keyframes fadeSlide {
            0% {
                opacity: 0;
                transform: translateY(10px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .fade-slide {
            animation: fadeSlide 0.4s ease-out;
        }

        @keyframes pulse-dot {
            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }
            50% {
                opacity: 0.4;
                transform: scale(0.85);
            }
        }
        .pulse-dot {
            animation: pulse-dot 1.6s ease-in-out infinite;
        }

        .role-badge {
            font-size: 0.7rem;
            font-weight: 600;
            padding: 0.2rem 0.7rem;
            border-radius: 999px;
            letter-spacing: 0.02em;
            display: inline-block;
        }
        .role-badge.buyer {
            background: rgba(34, 211, 238, 0.18);
            color: #67e8f9;
            border: 1px solid rgba(34, 211, 238, 0.25);
        }
        .role-badge.seller {
            background: rgba(168, 85, 247, 0.18);
            color: #c084fc;
            border: 1px solid rgba(168, 85, 247, 0.25);
        }

        /* Custom scroll for suggestions */
        .suggest-scroll::-webkit-scrollbar {
            width: 3px;
        }
        .suggest-scroll::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }

        /* Avatar label in 3D scene — positioned via JS */
        .avatar-label-3d {
            position: absolute;
            pointer-events: none;
            text-align: center;
            transform: translate(-50%, -50%);
            font-family: 'Inter', sans-serif;
            user-select: none;
            transition: opacity 0.2s;
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
        }
        .avatar-label-3d .name {
            font-weight: 600;
            font-size: 0.8rem;
            color: #f1f5f9;
            background: rgba(15, 23, 42, 0.7);
            padding: 0.1rem 0.6rem;
            border-radius: 6px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(4px);
        }
        .avatar-label-3d .role-tag {
            font-size: 0.55rem;
            font-weight: 500;
            letter-spacing: 0.04em;
            margin-top: 0.15rem;
            background: rgba(15, 23, 42, 0.65);
            padding: 0.05rem 0.5rem;
            border-radius: 4px;
            display: inline-block;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.06);
        }
        .avatar-label-3d .role-tag.buyer {
            color: #67e8f9;
            border-color: rgba(34, 211, 238, 0.2);
        }
        .avatar-label-3d .role-tag.seller {
            color: #c084fc;
            border-color: rgba(168, 85, 247, 0.2);
        }

        /* Setup picker */
        .color-dot {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.2s;
        }
        .color-dot:hover {
            transform: scale(1.12);
        }
        .color-dot.active {
            border-color: #22d3ee;
            box-shadow: 0 0 14px rgba(34, 211, 238, 0.35);
            transform: scale(1.1);
        }

        #avatar-preview {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            background: rgba(30, 41, 59, 0.5);
            border: 2px solid rgba(255, 255, 255, 0.06);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #avatar-preview svg {
            width: 100%;
            height: 100%;
        }

        .btn-join {
            background: linear-gradient(135deg, #22d3ee, #06b6d4);
            color: #0f172a;
            font-weight: 700;
            transition: all 0.25s;
            border: none;
        }
        .btn-join:hover {
            transform: scale(1.02);
            box-shadow: 0 0 30px rgba(34, 211, 238, 0.25);
        }
        .btn-join:disabled {
            opacity: 0.5;
            transform: none;
            box-shadow: none;
            cursor: not-allowed;
        }

        .btn-leave {
            background: rgba(239, 68, 68, 0.12);
            color: #fca5a5;
            border: 1px solid rgba(239, 68, 68, 0.2);
            transition: all 0.2s;
        }
        .btn-leave:hover {
            background: rgba(239, 68, 68, 0.22);
        }

        .suggestion-item {
            background: rgba(30, 41, 59, 0.5);
            border-left: 2px solid rgba(56, 189, 248, 0.25);
            padding: 0.5rem 0.7rem;
            border-radius: 6px;
            font-size: 0.7rem;
            color: #cbd5e1;
            line-height: 1.4;
            transition: background 0.15s;
        }
        .suggestion-item:hover {
            background: rgba(30, 41, 59, 0.8);
        }
        .suggestion-item .icon {
            margin-right: 0.4rem;
            opacity: 0.5;
        }
    </style>
</head>
<body>

    <!-- ============================================================ -->
    <!-- 3D CONTAINER — always visible behind overlays                  -->
    <!-- ============================================================ -->
    <div id="three-container" class="absolute inset-0 w-full h-full bg-slate-950 z-0"></div>

    <!-- ============================================================ -->
    <!-- VIEW: SETUP                                                   -->
    <!-- ============================================================ -->
    <div id="view-setup" class="relative z-10 w-full h-full flex items-center justify-center p-4">
        <div class="glass-panel rounded-3xl max-w-lg w-full p-7 shadow-2xl border border-white/5 fade-slide">
            <div class="flex items-center gap-3 mb-5 border-b border-slate-800/60 pb-4">
                <div class="w-10 h-10 rounded-2xl bg-cyan-500/10 flex items-center justify-center text-xl border border-cyan-500/20">
                    🛍️
                </div>
                <div>
                    <h1 class="font-bold text-white text-lg tracking-tight">Store Role-Play</h1>
                    <p class="text-xs text-slate-400">Negotiate in English · Real-time 3D</p>
                </div>
                <div class="ml-auto flex items-center gap-1.5">
                    <span id="setup-dot" class="w-2.5 h-2.5 rounded-full bg-slate-600 pulse-dot"></span>
                    <span id="setup-conn-label" class="text-[10px] text-slate-500">connecting...</span>
                </div>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Your Name</label>
                    <input type="text" id="input-name" maxlength="16" placeholder="e.g. Alex"
                    class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-slate-200 outline-none focus:border-cyan-500/60 transition placeholder:text-slate-500" />
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Room Code</label>
                    <input type="text" id="input-room" maxlength="20" value="store-01"
                    class="w-full bg-slate-800/80 border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-slate-200 font-mono outline-none focus:border-cyan-500/60 transition" />
                    <p class="text-[10px] text-slate-500 mt-1">Share this code with your negotiation partner.</p>
                </div>

                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1.5">Avatar</label>
                    <div class="flex items-center gap-4">
                        <div id="avatar-preview" class="flex-shrink-0"></div>
                        <div class="flex-1 space-y-2">
                            <div class="flex gap-2">
                                <button type="button" onclick="setAvatarGender('male')" id="btn-gender-m"
                                class="flex-1 py-1.5 rounded-lg text-xs font-semibold border transition bg-slate-800 text-slate-300 border-slate-700 hover:border-slate-500">
                                🧔 Male
                            </button>
                            <button type="button" onclick="setAvatarGender('female')" id="btn-gender-f"
                            class="flex-1 py-1.5 rounded-lg text-xs font-semibold border transition bg-slate-800 text-slate-300 border-slate-700 hover:border-slate-500">
                            👩 Female
                        </button>
                    </div>
                    <div>
                        <label class="text-[10px] text-slate-500 block mb-1">Skin</label>
                        <div id="skin-picker" class="flex gap-1.5 flex-wrap"></div>
                    </div>
                </div>
            </div>
        </div>

        <button onclick="joinRoom()" id="btn-join" class="btn-join w-full py-3.5 rounded-2xl text-sm mt-2 transition">
            🚀 Enter Store
        </button>
        <p id="join-error" class="hidden text-xs text-red-400 text-center mt-2"></p>
    </div>
</div>
</div>

<!-- ============================================================ -->
<!-- VIEW: MEETING                                                 -->
<!-- ============================================================ -->
<div id="view-meeting" class="hidden relative z-10 w-full h-full">
    <!-- Top bar -->
    <header class="absolute top-0 left-0 right-0 p-3 md:p-4 flex items-center justify-between z-20 pointer-events-none">
        <div class="glass-panel px-4 py-2 rounded-2xl flex items-center gap-3 pointer-events-auto shadow-xl">
            <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 pulse-dot"></div>
            <div>
                <div class="flex items-center gap-2">
                    <span class="font-semibold text-sm text-white">🛍️ Store</span>
                    <span class="text-[10px] text-slate-400 font-mono bg-slate-800/60 px-2 py-0.5 rounded border border-slate-700/50">
                        <span id="meeting-room-code">store-01</span>
                    </span>
                </div>
                <p class="text-[10px] text-slate-400"><span id="meeting-player-count">0</span> participants</p>
            </div>
        </div>

        <div class="flex items-center gap-2 pointer-events-auto">
            <button onclick="toggleOrbit()" id="orbit-btn"
            class="glass-light px-3 py-1.5 rounded-xl text-[10px] font-medium text-slate-300 border border-white/5 hover:border-white/15 transition flex items-center gap-1.5">
            🔄 Orbit
        </button>
        <button onclick="leaveRoom()" class="btn-leave px-3 py-1.5 rounded-xl text-[10px] font-medium transition flex items-center gap-1.5">
            ✕ Leave
        </button>
