</header>

<!-- Bottom: Role + Suggestions (collapsible, minimal) -->
<div class="absolute bottom-4 left-4 right-4 z-20 pointer-events-none flex flex-wrap items-end justify-between gap-3">
    <!-- Role badge + suggestion toggle -->
    <div class="pointer-events-auto glass-panel rounded-2xl px-4 py-2.5 flex items-center gap-4 shadow-xl border border-white/5">
        <div>
            <div class="text-[9px] text-slate-500 uppercase tracking-wider">Your Role</div>
            <div id="meeting-role-badge" class="role-badge buyer mt-0.5">Buyer</div>
        </div>
        <div class="w-px h-8 bg-slate-700/50"></div>
        <button onclick="toggleSuggestions()" id="suggest-toggle"
        class="text-xs text-slate-300 hover:text-white transition flex items-center gap-1.5">
        💬 <span id="suggest-toggle-label">Show Suggestions</span>
    </button>
</div>

<!-- Quick hint -->
<div class="pointer-events-auto glass-light rounded-xl px-3 py-1.5 text-[10px] text-slate-400 border border-white/5">
    🗣️ Speak in English · Your role is private
</div>
</div>

<!-- Suggestions panel (slide-up) -->
<div id="suggestions-panel" class="absolute bottom-[5.5rem] left-4 right-4 md:left-auto md:right-6 md:w-80 z-20 pointer-events-none hidden">
    <div class="glass-panel rounded-2xl p-4 shadow-2xl border border-white/5 pointer-events-auto max-h-[50vh] overflow-y-auto suggest-scroll fade-slide">
        <div class="flex items-center justify-between border-b border-slate-800/60 pb-2 mb-2.5">
            <span class="text-xs font-medium text-amber-300/80">💡 Suggestions (English)</span>
            <span class="text-[9px] text-slate-500">private</span>
        </div>
        <ul id="suggestions-list" class="space-y-1.5"></ul>
    </div>
</div>
</div>

<!-- ============================================================ -->
<!-- JAVASCRIPT                                                    -->
<!-- ============================================================ -->
<script>
    // =============================================================
    // FIREBASE SETUP
    // =============================================================
    const FIREBASE_BASE = "https://english-meetings-f08e4-default-rtdb.firebaseio.com";

    function setConnStatus(ok, label) {
        const dot = document.getElementById('setup-dot');
        const lbl = document.getElementById('setup-conn-label');
        dot.className = ok ?
            'w-2.5 h-2.5 rounded-full bg-emerald-400 pulse-dot' :
            'w-2.5 h-2.5 rounded-full bg-red-500 pulse-dot';
        lbl.textContent = label;
    }
    setConnStatus(false, 'connecting...');
    fetch(`${FIREBASE_BASE}/.json?shallow=true`)
        .then(r => { if (!r.ok) throw new Error(); setConnStatus(true, 'connected'); })
        .catch(() => setConnStatus(false, 'offline'));

    function playerUrl(room, id) { return `${FIREBASE_BASE}/rooms/${encodeURIComponent(room)}/players/${encodeURIComponent(id)}.json`; }

    function playersUrl(room) { return `${FIREBASE_BASE}/rooms/${encodeURIComponent(room)}/players.json`; }

    // =============================================================
    // AVATAR STATE & GENERATION (SVG → Canvas → Texture)
    // =============================================================
    let avatarState = {
        gender: 'male',
        skin: '#fed7aa',
        shirt: '#0284c7',
        hair: 'short',
        expression: 'happy',
        glasses: false,
        headset: false
    };

    const SKINS = ['#f8fafc', '#fde047', '#fbcfe8', '#fed7aa', '#d97706', '#78350f'];
    const SHIRTS = ['#0284c7', '#7c3aed', '#059669', '#dc2626', '#475569', '#ea580c'];

    function setAvatarGender(g) {
        avatarState.gender = g;
        document.getElementById('btn-gender-m').className = g === 'male' ?
            'flex-1 py-1.5 rounded-lg text-xs font-semibold border transition bg-cyan-500/20 text-cyan-300 border-cyan-500/40' :
            'flex-1 py-1.5 rounded-lg text-xs font-semibold border transition bg-slate-800 text-slate-300 border-slate-700 hover:border-slate-500';
        document.getElementById('btn-gender-f').className = g === 'female' ?
            'flex-1 py-1.5 rounded-lg text-xs font-semibold border transition bg-purple-500/20 text-purple-300 border-purple-500/40' :
            'flex-1 py-1.5 rounded-lg text-xs font-semibold border transition bg-slate-800 text-slate-300 border-slate-700 hover:border-slate-500';
        if (g === 'female') document.getElementById('hair-select').value = 'long';
        else document.getElementById('hair-select').value = 'short';
        renderPreview();
    }

    function setSkin(c) { avatarState.skin = c;
        renderSkinPickers();
        renderPreview(); }

    function setShirt(c) { avatarState.shirt = c;
        renderShirtPickers();
        renderPreview(); }

    function renderSkinPickers() {
        const container = document.getElementById('skin-picker');
        container.innerHTML = SKINS.map(c =>
            `<div class="color-dot ${avatarState.skin === c ? 'active' : ''}" style="background:${c}" onclick="setSkin('${c}')"></div>`
        ).join('');
    }

    function renderShirtPickers() {
        const container = document.getElementById('shirt-picker');
        if (!container) return;
        container.innerHTML = SHIRTS.map(c =>
            `<div class="color-dot ${avatarState.shirt === c ? 'active' : ''}" style="background:${c}" onclick="setShirt('${c}')"></div>`
        ).join('');
    }

    // We'll use a select for hair instead of multiple buttons
    function renderPreview() {
        const container = document.getElementById('avatar-preview');
        container.innerHTML = generateAvatarSVG(avatarState);
    }

    // Expose hair change
    window.onHairChange = function(val) {
        avatarState.hair = val;
        renderPreview();
    };

    function generateAvatarSVG(cfg) {
        const isFemale = cfg.gender === 'female';
        const shoulderPath = isFemale ? 'M 24 95 C 24 72, 76 72, 76 95 Z' : 'M 18 95 C 18 68, 82 68, 82 95 Z';
        const lipColor = isFemale ? '#be185d' : '#0f172a';
        const lashes = isFemale ?
            `<line x1="37" y1="32" x2="34" y2="30" stroke="#0f172a" stroke-width="1"/>
               <line x1="63" y1="32" x2="66" y2="30" stroke="#0f172a" stroke-width="1"/>` :
            '';
        const hairSVG = getHairSVG(cfg.hair, isFemale);

        return `
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <path d="M 44 58 L 56 58 L 56 68 L 44 68 Z" fill="${cfg.skin}" opacity="0.9"/>
          <path d="${shoulderPath}" fill="${cfg.shirt}"/>
          <path d="M 30 36 C 30 18, 70 18, 70 36 C 70 56, 30 56, 30 36 Z" fill="${cfg.skin}"/>
          <circle cx="29" cy="38" r="4" fill="${cfg.skin}"/>
          <circle cx="71" cy="38" r="4" fill="${cfg.skin}"/>
          ${hairSVG}
          <g class="eye">
            <ellipse cx="41" cy="36" rx="3" ry="4" fill="#0f172a"/>
            <ellipse cx="59" cy="36" rx="3" ry="4" fill="#0f172a"/>
          </g>
          ${lashes}
          <path d="M 37 29 Q 41 27 45 29" fill="none" stroke="#1e293b" stroke-width="1.5"/>
          <path d="M 55 29 Q 59 27 63 29" fill="none" stroke="#1e293b" stroke-width="1.5"/>
          <path d="M 50 37 L 48 42 L 51 42" fill="none" stroke="#94a3b8" stroke-width="1.2"/>
          ${cfg.expression === 'happy' ? `<path d="M 42 46 Q 50 52 58 46" fill="none" stroke="${lipColor}" stroke-width="2" stroke-linecap="round"/>` : ''}
          ${cfg.expression === 'neutral' ? `<line x1="43" y1="48" x2="57" y2="48" stroke="${lipColor}" stroke-width="2" stroke-linecap="round"/>` : ''}
          ${cfg.expression === 'focused' ? `<path d="M 44 49 Q 50 46 56 49" fill="none" stroke="${lipColor}" stroke-width="2" stroke-linecap="round"/>` : ''}
          ${cfg.glasses ? '<circle cx="41" cy="36" r="7" fill="none" stroke="#0f172a" stroke-width="1.5"/><circle cx="59" cy="36" r="7" fill="none" stroke="#0f172a" stroke-width="1.5"/><line x1="48" y1="36" x2="51" y2="36" stroke="#0f172a" stroke-width="1.5"/>' : ''}
          ${cfg.headset ? '<path d="M 27 34 C 27 12, 73 12, 73 34" fill="none" stroke="#38bdf8" stroke-width="2.5"/><rect x="25" y="30" width="5" height="12" rx="2" fill="#0369a1"/><rect x="70" y="30" width="5" height="12" rx="2" fill="#0369a1"/>' : ''}
        </svg>`;
    }

    function getHairSVG(style, isFemale) {
        const color = "#1e293b";
        if (style === 'short') return `<path d="M 28 26 C 30 10, 70 10, 72 26 C 65 18, 35 18, 28 26 Z" fill="${color}"/>`;
        if (style === 'curly')
            return `<circle cx="34" cy="18" r="8" fill="${color}"/><circle cx="50" cy="14" r="9" fill="${color}"/><circle cx="66" cy="18" r="8" fill="${color}"/>`;
        if (style === 'long')
            return `<path d="M 26 30 C 26 8, 74 8, 74 30 L 76 ${isFemale ? 66 : 56} L 68 ${isFemale ? 66 : 56} L 68 28 C 68 20, 32 20, 32 28 L 32 ${isFemale ? 66 : 56} L 24 ${isFemale ? 66 : 56} Z" fill="${color}"/>`;
        return '';
    }

    // Convert SVG to image/canvas for Three.js texture
    function svgToTexture(svgStr, callback) {
        const blob = new Blob([svgStr], { type: 'image/svg+xml' });
        const url = URL.createObjectURL(blob);
        const img = new Image();
        img.onload = function() {
            const canvas = document.createElement('canvas');
            canvas.width = 128;
            canvas.height = 128;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, 128, 128);
            URL.revokeObjectURL(url);
            callback(canvas);
        };
        img.onerror = function() {
            // fallback: generate a simple colored circle
            const canvas = document.createElement('canvas');
            canvas.width = 128;
            canvas.height = 128;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#1e293b';
            ctx.beginPath();
            ctx.arc(64, 64, 56, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = '#f1f5f9';
            ctx.font = '48px sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('👤', 64, 68);
            callback(canvas);
        };
        img.src = url;
    }

    // =============================================================
    // ROLE & SUGGESTIONS DATA
    // =============================================================
    const ROLE_DATA = {
        buyer: {
            label: 'Buyer',
            css: 'buyer',
            desc: 'You are the buyer. Ask about price, quality, and terms.',
            suggestions: [
                "Could you tell me more about this item?",
                "Is there any room for a discount?",
                "What's included in the price?",
                "Do you offer a warranty or guarantee?",
                "What are the payment options?",
                "Can you match a competitor's price?",
                "Is this available in other colors/sizes?",
                "What's your return policy?"
            ]
        },
        seller: {
            label: 'Seller',
            css: 'seller',
            desc: 'You are the seller. Present value, benefits, and close the deal.',
            suggestions: [
                "This product offers great value because...",
                "I can offer you a special discount today.",
                "Let me explain the key benefits.",
                "We provide a full warranty on all items.",
                "Our payment terms are very flexible.",
                "This is a limited-time promotion.",
                "We guarantee fast delivery.",
                "Let me show you why this is worth the price."
            ]
        }
    };

    // =============================================================
    // THREE.JS — 3D DEPARTMENT STORE SCENE
    // =============================================================
    let scene, camera, renderer, controls;
    let storeGroup, avatarSprites = {};
    let labelContainer = document.createElement('div');
    labelContainer.style.position = 'absolute';
    labelContainer.style.top = '0';
    labelContainer.style.left = '0';
    labelContainer.style.width = '100%';
    labelContainer.style.height = '100%';
    labelContainer.style.pointerEvents = 'none';
    labelContainer.style.overflow = 'hidden';
    labelContainer.style.zIndex = '5';
    document.body.appendChild(labelContainer);

    let labelElements = {};
    let isOrbiting = false;
    let orbitAngle = 0;
    let targetCamPos = { x: 5, y: 3.5, z: 5 };
    let targetLookAt = { x: 0, y: 1.2, z: 0 };

    function initThree() {
        const container = document.getElementById('three-container');
        scene = new THREE.Scene();
        scene.background = new THREE.Color(0x0b1120);
        scene.fog = new THREE.FogExp2(0x0b1120, 0.028);

        camera = new THREE.PerspectiveCamera(42, window.innerWidth / window.innerHeight, 0.1, 40);
        camera.position.set(targetCamPos.x, targetCamPos.y, targetCamPos.z);

        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.0;
        container.appendChild(renderer.domElement);

        controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.06;
        controls.maxPolarAngle = Math.PI / 2 - 0.03;
        controls.minDistance = 2.2;
        controls.maxDistance = 14;
        controls.target.set(0, 1.2, 0);
        controls.update();

        buildStore();
        animateThree();

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    }

    function buildStore() {
        storeGroup = new THREE.Group();
        scene.add(storeGroup);

        // ---- Floor ----
        const floorGeo = new THREE.PlaneGeometry(18, 18);
        const floorMat = new THREE.MeshStandardMaterial({
            color: 0x1a2236,
            roughness: 0.35,
            metalness: 0.2,
        });
        const floor = new THREE.Mesh(floorGeo, floorMat);
        floor.rotation.x = -Math.PI / 2;
        floor.receiveShadow = true;
        storeGroup.add(floor);

        // Floor tile grid (subtle)
        const gridHelper = new THREE.GridHelper(18, 24, 0x2a3a5a, 0x1a2a4a);
        gridHelper.position.y = 0.01;
        storeGroup.add(gridHelper);

        // ---- Back wall ----
        const wallMat = new THREE.MeshStandardMaterial({ color: 0x0d1528, roughness: 0.7 });
        const backWall = new THREE.Mesh(new THREE.PlaneGeometry(18, 7), wallMat);
        backWall.position.set(0, 3.5, -8.5);
        storeGroup.add(backWall);

        // ---- Side walls ----
        for (let s of [-1, 1]) {
            const side = new THREE.Mesh(new THREE.PlaneGeometry(18, 7), wallMat);
            side.position.set(s * 8.5, 3.5, 0);
            side.rotation.y = s * Math.PI / 2;
            storeGroup.add(side);
        }

        // ---- Shelves (back wall) ----
        const shelfMat = new THREE.MeshStandardMaterial({ color: 0x1e2a4a, metalness: 0.5, roughness: 0.4 });
        for (let row = 0; row < 3; row++) {
            const yPos = 1.2 + row * 1.6;
            const shelf = new THREE.Mesh(new THREE.BoxGeometry(12, 0.08, 0.6), shelfMat);
            shelf.position.set(0, yPos, -7.8);
            shelf.castShadow = true;
            storeGroup.add(shelf);

            // Products on shelf
            for (let p = -5; p <= 5; p += 1.6) {
                const h = 0.25 + Math.random() * 0.4;
                const w = 0.2 + Math.random() * 0.2;
                const d = 0.2 + Math.random() * 0.2;
                const prodMat = new THREE.MeshStandardMaterial({
                    color: new THREE.Color().setHSL(0.55 + Math.random() * 0.35, 0.4, 0.4 + Math.random() * 0.3),
                    roughness: 0.5,
                });
                const prod = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), prodMat);
                prod.position.set(p, yPos + h / 2, -7.5 + Math.random() * 0.2);
                prod.castShadow = true;
                storeGroup.add(prod);
            }
        }

        // ---- COUNTER / DESK (main feature) ----
        const counterGroup = new THREE.Group();

        // Top
        const topMat = new THREE.MeshPhysicalMaterial({
            color: 0x2a3a5a,
            metalness: 0.1,
            roughness: 0.15,
            transparent: true,
            opacity: 0.92,
        });
        const top = new THREE.Mesh(new THREE.BoxGeometry(4.2, 0.1, 1.8), topMat);
        top.position.y = 1.2;
        top.castShadow = true;
        top.receiveShadow = true;
        counterGroup.add(top);

        // Base
        const baseMat = new THREE.MeshStandardMaterial({ color: 0x1a2a4a, roughness: 0.6 });
        const base = new THREE.Mesh(new THREE.BoxGeometry(3.8, 1.1, 1.4), baseMat);
        base.position.y = 0.6;
        base.castShadow = true;
        counterGroup.add(base);

        // LED strip under counter
        const ledMat = new THREE.MeshBasicMaterial({ color: 0x22d3ee });
        const led = new THREE.Mesh(new THREE.BoxGeometry(3.6, 0.02, 0.06), ledMat);
        led.position.set(0, 0.05, 0.75);
        counterGroup.add(led);
        const led2 = led.clone();
        led2.position.z = -0.75;
        counterGroup.add(led2);

        // Small display items on counter
        const itemMat = new THREE.MeshStandardMaterial({ color: 0xfbbf24, roughness: 0.3, metalness: 0.1 });
        for (let i = -1; i <= 1; i += 0.8) {
            const item = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.15, 0.15), itemMat);
            item.position.set(i * 0.8, 1.28, 0.55);
            item.castShadow = true;
            counterGroup.add(item);
        }

        counterGroup.position.y = 0;
        storeGroup.add(counterGroup);

        // ---- Floor accent lights ----
        const accentMat = new THREE.MeshBasicMaterial({ color: 0x1e3a5a, transparent: true, opacity: 0.15 });
        for (let x of [-2.5, 2.5]) {
            const dot = new THREE.Mesh(new THREE.CircleGeometry(0.5, 16), accentMat);
            dot.rotation.x = -Math.PI / 2;
            dot.position.set(x, 0.02, 0);
            storeGroup.add(dot);
        }

        // ---- Ambient lighting ----
        const amb = new THREE.AmbientLight(0x2a3a6a, 0.6);
        scene.add(amb);

        const mainLight = new THREE.SpotLight(0xffeedd, 2.2);
        mainLight.position.set(0, 7, 0);
        mainLight.angle = Math.PI / 2.8;
        mainLight.penumbra = 0.7;
        mainLight.castShadow = true;
        mainLight.shadow.mapSize.width = 1024;
        mainLight.shadow.mapSize.height = 1024;
        scene.add(mainLight);

        const fill = new THREE.DirectionalLight(0x4488ff, 0.8);
        fill.position.set(2, 4, -4);
        scene.add(fill);

        const backLight = new THREE.DirectionalLight(0x6688cc, 0.5);
        backLight.position.set(-2, 3, 6);
        scene.add(backLight);

        // Small point light at counter
        const counterLight = new THREE.PointLight(0x22d3ee, 0.6, 4);
        counterLight.position.set(0, 1.6, 0);
        scene.add(counterLight);
    }

    // =============================================================
    // AVATAR SPRITE MANAGEMENT IN 3D
    // =============================================================
    const avatarPositions = {
        // Two sides of the counter
        buyer: { x: -1.6, z: 1.6 },
        seller: { x: 1.6, z: -1.6 },
        // Additional seats for more participants
        extra: [
            { x: -2.6, z: 0.8 },
            { x: 2.6, z: -0.8 },
            { x: -2.6, z: -0.8 },
            { x: 2.6, z: 0.8 },
        ]
    };

    let avatarTextureCache = {};

    function getAvatarPosition(role, index) {
        if (role === 'buyer') return avatarPositions.buyer;
        if (role === 'seller') return avatarPositions.seller;
        const extra = avatarPositions.extra;
        return extra[index % extra.length] || { x: 0, z: 0 };
    }

    function createAvatarSprite(playerId, playerData) {
        // Remove old sprite if exists
        if (avatarSprites[playerId]) {
            scene.remove(avatarSprites[playerId]);
            delete avatarSprites[playerId];
        }
        if (labelElements[playerId]) {
            labelContainer.removeChild(labelElements[playerId]);
            delete labelElements[playerId];
        }

        const cfg = playerData.avatarConfig || avatarState;
        const svgStr = generateAvatarSVG(cfg);
        const role = playerData.role || 'buyer';
        const name = playerData.name || 'Guest';

        svgToTexture(svgStr, (canvas) => {
            const texture = new THREE.CanvasTexture(canvas);
            texture.needsUpdate = true;

            const spriteMat = new THREE.SpriteMaterial({
                map: texture,
                transparent: true,
                depthWrite: false,
                sizeAttenuation: true,
            });
            const sprite = new THREE.Sprite(spriteMat);
            sprite.scale.set(1.6, 1.6, 1);

            // Position
            const pos = getAvatarPosition(role, Object.keys(avatarSprites).length);
            sprite.position.set(pos.x, 1.4, pos.z);
            sprite.userData = { playerId, role, name };

            scene.add(sprite);
            avatarSprites[playerId] = sprite;

            // Create HTML label
            const label = document.createElement('div');
            label.className = 'avatar-label-3d';
            label.innerHTML = `
                <div class="name">${escapeHtml(name)}</div>
                <div class="role-tag ${role}">${role === 'buyer' ? '🛒 Buyer' : '📦 Seller'}</div>
            `;
            labelContainer.appendChild(label);
            labelElements[playerId] = label;

            // Also update existing labels positions
            updateLabelPositions();
        });
    }

    function escapeHtml(str) {
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
    }

    function updateLabelPositions() {
        // Project 3D positions to screen space for each label
        const width = window.innerWidth;
        const height = window.innerHeight;

        for (const [id, sprite] of Object.entries(avatarSprites)) {
            const label = labelElements[id];
            if (!label) continue;

            const pos = sprite.position.clone();
            pos.y += 1.1; // above sprite

            pos.project(camera);
            const x = (pos.x * 0.5 + 0.5) * width;
            const y = (-pos.y * 0.5 + 0.5) * height;

            // Only show if in front of camera
            if (pos.z < 1) {
                label.style.display = 'block';
                label.style.left = x + 'px';
                label.style.top = y + 'px';
                label.style.opacity = '1';
            } else {
                label.style.display = 'none';
            }
        }
    }

    function renderAllAvatars(playersData) {
        // Remove sprites for players that left
        const currentIds = Object.keys(playersData);
        for (const id of Object.keys(avatarSprites)) {
            if (!currentIds.includes(id)) {
                scene.remove(avatarSprites[id]);
                delete avatarSprites[id];
                if (labelElements[id]) {
                    labelContainer.removeChild(labelElements[id]);
                    delete labelElements[id];
                }
            }
        }

        // Add/update sprites for current players
        for (const [id, data] of Object.entries(playersData)) {
            if (!avatarSprites[id]) {
                createAvatarSprite(id, data);
            } else {
                // Update existing sprite if config changed
                // For simplicity, we just recreate if the config seems different
                // We'll update the sprite by recreating it
                const old = avatarSprites[id];
                const oldCfg = old.userData;
                if (oldCfg.name !== data.name || oldCfg.role !== data.role) {
                    // Recreate
                    scene.remove(old);
                    delete avatarSprites[id];
                    if (labelElements[id]) {
                        labelContainer.removeChild(labelElements[id]);
                        delete labelElements[id];
                    }
                    createAvatarSprite(id, data);
                }
            }
        }

        // Update player count
        document.getElementById('meeting-player-count').textContent = currentIds.length;
    }

    // =============================================================
    // THREE.JS ANIMATION LOOP
    // =============================================================
    function animateThree() {
        requestAnimationFrame(animateThree);

        // Orbit animation
        if (isOrbiting) {
            orbitAngle += 0.004;
            const r = 6.5;
            targetCamPos.x = Math.sin(orbitAngle) * r;
            targetCamPos.z = Math.cos(orbitAngle) * r;
            targetCamPos.y = 3.0 + Math.sin(orbitAngle * 0.6) * 0.4;
        }

        // Smooth camera
        camera.position.x += (targetCamPos.x - camera.position.x) * 0.035;
        camera.position.y += (targetCamPos.y - camera.position.y) * 0.035;
        camera.position.z += (targetCamPos.z - camera.position.z) * 0.035;

        controls.target.x += (targetLookAt.x - controls.target.x) * 0.035;
        controls.target.y += (targetLookAt.y - controls.target.y) * 0.035;
        controls.target.z += (targetLookAt.z - controls.target.z) * 0.035;

        controls.update();
        updateLabelPositions();
        renderer.render(scene, camera);
    }

    function toggleOrbit() {
        isOrbiting = !isOrbiting;
        const btn = document.getElementById('orbit-btn');
        if (isOrbiting) {
            btn.classList.add('bg-cyan-500/10', 'border-cyan-500/20');
            btn.classList.remove('border-white/5');
        } else {
            btn.classList.remove('bg-cyan-500/10', 'border-cyan-500/20');
            btn.classList.add('border-white/5');
        }
    }

    // =============================================================
    // ROOM MANAGEMENT (Firebase)
    // =============================================================
    let currentRoom = null;
    let playerId = null;
    let myRole = null;
    let roomPlayers = {};
    let eventSource = null;
    let myName = '';

    function getOrCreatePlayerId() {
        let id = sessionStorage.getItem('store_player_id');
        if (!id) {
            id = 'p-' + Date.now() + '-' + Math.random().toString(16).slice(2, 8);
            sessionStorage.setItem('store_player_id', id);
        }
        return id;
    }

    async function joinRoom() {
        const name = document.getElementById('input-name').value.trim();
        const room = document.getElementById('input-room').value.trim();
        const errEl = document.getElementById('join-error');
        errEl.classList.add('hidden');

        if (!name) { errEl.textContent = 'Please enter your name.';
            errEl.classList.remove('hidden'); return; }
        if (!room) { errEl.textContent = 'Please enter a room code.';
            errEl.classList.remove('hidden'); return; }

        const btn = document.getElementById('btn-join');
        btn.disabled = true;
        btn.textContent = 'Joining...';

        currentRoom = room;
        playerId = getOrCreatePlayerId();
        myName = name;

        try {
            // Check if player exists
            const existingRes = await fetch(playerUrl(room, playerId));
            const existing = existingRes.ok ? await existingRes.json() : null;

            if (existing && existing.role) {
                myRole = existing.role;
            } else {
                // Assign role based on current player count
                const allRes = await fetch(playersUrl(room));
                const all = allRes.ok ? (await allRes.json() || {}) : {};
                const count = Object.keys(all).length;
                myRole = (count % 2 === 0) ? 'buyer' : 'seller';
            }

            // Read hair selection from the hidden select
            const hairSelect = document.getElementById('hair-select');
            if (hairSelect) avatarState.hair = hairSelect.value;

            await writeMyData();

            window.addEventListener('beforeunload', leaveBeacon);
            enterMeetingView();
            listenToRoom(room);
        } catch (err) {
            console.error(err);
            errEl.textContent = 'Could not connect. Check your network.';
            errEl.classList.remove('hidden');
            btn.disabled = false;
            btn.textContent = '🚀 Enter Store';
        }
    }

    function writeMyData() {
        return fetch(playerUrl(currentRoom, playerId), {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name: myName,
                gender: avatarState.gender,
                avatarConfig: avatarState,
                role: myRole,
                joinedAt: Date.now()
            })
        });
    }

    function leaveBeacon() {
        if (currentRoom && playerId) {
            fetch(playerUrl(currentRoom, playerId), { method: 'DELETE', keepalive: true });
        }
    }

    function enterMeetingView() {
        document.getElementById('view-setup').style.display = 'none';
        document.getElementById('view-meeting').classList.remove('hidden');

        document.getElementById('meeting-room-code').textContent = currentRoom;

        const info = ROLE_DATA[myRole];
        const badge = document.getElementById('meeting-role-badge');
        badge.textContent = info.label;
        badge.className = `role-badge ${info.css}`;

        // Show suggestions
        const list = document.getElementById('suggestions-list');
        list.innerHTML = info.suggestions.map(s =>
            `<li class="suggestion-item"><span class="icon">💡</span> ${s}</li>`
        ).join('');

        // Initialize 3D if not already
        if (!scene) initThree();

        // Update avatar preview in setup (we're in meeting now)
    }

    function listenToRoom(room) {
        if (eventSource) { eventSource.close(); }

        eventSource = new EventSource(playersUrl(room));
        eventSource.addEventListener('put', (e) => {
            try { const { path, data } = JSON.parse(e.data);
                applyUpdate(path, data); } catch (_) {}
        });
        eventSource.addEventListener('patch', (e) => {
            try { const { path, data } = JSON.parse(e.data);
                applyUpdate(path, data); } catch (_) {}
        });
        eventSource.onerror = () => { /* auto-reconnect */ };
        eventSource.onopen = () => { setConnStatus(true, 'connected'); };
    }

    function applyUpdate(path, data) {
        if (path === '/' || path === '') {
            roomPlayers = data || {};
        } else {
            const key = path.replace(/^\//, '').split('/')[0];
            if (data === null) {
                delete roomPlayers[key];
            } else if (path === `/${key}`) {
                roomPlayers[key] = data;
            } else {
                roomPlayers[key] = roomPlayers[key] || {};
                const sub = path.replace(`/${key}/`, '').split('/');
                let obj = roomPlayers[key];
                for (let i = 0; i < sub.length - 1; i++) {
                    obj[sub[i]] = obj[sub[i]] || {};
                    obj = obj[sub[i]];
                }
                obj[sub[sub.length - 1]] = data;
            }
        }
        // Update 3D avatars
        renderAllAvatars(roomPlayers);
    }

    function toggleSuggestions() {
        const panel = document.getElementById('suggestions-panel');
        const label = document.getElementById('suggest-toggle-label');
        if (panel.classList.contains('hidden')) {
            panel.classList.remove('hidden');
            label.textContent = 'Hide Suggestions';
        } else {
            panel.classList.add('hidden');
            label.textContent = 'Show Suggestions';
        }
    }

    function leaveRoom() {
        window.removeEventListener('beforeunload', leaveBeacon);
        if (currentRoom && playerId) {
            fetch(playerUrl(currentRoom, playerId), { method: 'DELETE' }).catch(() => {});
        }
        if (eventSource) { eventSource.close();
            eventSource = null; }
        sessionStorage.removeItem('store_player_id');

        // Clean up sprites
        for (const id of Object.keys(avatarSprites)) {
            scene.remove(avatarSprites[id]);
            delete avatarSprites[id];
            if (labelElements[id]) {
                labelContainer.removeChild(labelElements[id]);
                delete labelElements[id];
            }
        }
        roomPlayers = {};
        currentRoom = null;
        playerId = null;

        document.getElementById('view-meeting').classList.add('hidden');
        document.getElementById('view-setup').style.display = 'flex';
        document.getElementById('btn-join').disabled = false;
        document.getElementById('btn-join').textContent = '🚀 Enter Store';
        document.getElementById('suggestions-panel').classList.add('hidden');
        document.getElementById('suggest-toggle-label').textContent = 'Show Suggestions';
        document.getElementById('meeting-player-count').textContent = '0';
    }

    // =============================================================
    // INIT
    // =============================================================
    window.onload = function() {
        // Setup avatar preview
        renderSkinPickers();
        renderShirtPickers();
        renderPreview();

        // Add hair select to the DOM (we need it in the setup)
        const hairContainer = document.getElementById('avatar-preview').parentElement;
        const hairDiv = document.createElement('div');
        hairDiv.className = 'mt-2';
        hairDiv.innerHTML = `
            <label class="text-[10px] text-slate-500 block mb-0.5">Hair</label>
            <select id="hair-select" onchange="window.onHairChange(this.value)" class="w-full bg-slate-800/80 border border-slate-700 rounded-lg px-2 py-1 text-xs text-slate-200 outline-none focus:border-cyan-500/60">
                <option value="short">Short</option>
                <option value="curly">Curly</option>
                <option value="long">Long</option>
                <option value="bald">Bald</option>
            </select>
        `;
        // Insert after the skin picker
        const skinPicker = document.getElementById('skin-picker');
        skinPicker.parentElement.after(hairDiv);

        // Also add shirt picker if not present
        const shirtDiv = document.createElement('div');
        shirtDiv.className = 'mt-2';
        shirtDiv.innerHTML = `
            <label class="text-[10px] text-slate-500 block mb-0.5">Shirt</label>
            <div id="shirt-picker" class="flex gap-1.5 flex-wrap"></div>
        `;
        document.getElementById('skin-picker').parentElement.after(shirtDiv);
        renderShirtPickers();

        // Set default gender
        setAvatarGender('male');

        // Enter key support
        document.getElementById('input-name').addEventListener('keydown', (e) => { if (e.key === 'Enter') joinRoom(); });
        document.getElementById('input-room').addEventListener('keydown', (e) => { if (e.key === 'Enter') joinRoom(); });
    };

    // Also need to handle the shirt picker re-render
    const origRenderShirt = renderShirtPickers;
    renderShirtPickers = function() {
        const container = document.getElementById('shirt-picker');
        if (!container) return;
        container.innerHTML = SHIRTS.map(c =>
            `<div class="color-dot ${avatarState.shirt === c ? 'active' : ''}" style="background:${c}" onclick="setShirt('${c}')"></div>`
        ).join('');
    };
    // Override setShirt to re-render both
    const origSetShirt = setShirt;
    setShirt = function(c) {
        avatarState.shirt = c;
        renderShirtPickers();
        renderPreview();
    };

    console.log('🛍️ Department Store Role-Play loaded.');
</script>

